<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:VLCPlayer.Controls"
             x:Class="VLCPlayer.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <controls:MediaViewer x:Name="VideoViewer" WidthRequest="300" HeightRequest="300" HorizontalOptions="CenterAndExpand" VideoUrl="http://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ElephantsDream.mp4"/>

            <Button Text="Play" Clicked="BtnPlay_Clicked"/>
            <Button Text="Pause" Clicked="BtnPause_Clicked"/>
            <Button Text="Stop" Clicked="BtnStop_Clicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
